@* 
    This is the INDEX VIEW - it displays the list of all games
    VIEWS are HTML templates that show information to the user
    The @ symbol lets us write C# code inside HTML
*@
@model List<GameTracker.Models.Game>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
@* 
    @model tells us what type of data this view expects
    In this case, we expect a List of Game objects from the controller
*@

@{
    ViewData["Title"] = "My Game Backlog";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1>?? My Game Backlog</h1>
        <p class="text-muted">Track all the games you want to play!</p>
    </div>
    <div class="col-md-4 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="Create" class="btn btn-primary">
            ? Add New Game
        </a>
    </div>
</div>

<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            <label>Find by name: <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" /></label>
            <input type="submit" value="Search" class="btn btn-default" /> 
        </p>
    </div>
</form>

@* Show statistics about the games *@
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h3>@Model.Count</h3>
                <p class="text-muted mb-0">Total Games</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h3>@Model.Count(g => g.IsCompleted)</h3>
                <p class="text-muted mb-0">Completed</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h3>@Model.Count(g => !g.IsCompleted)</h3>
                <p class="text-muted mb-0">Still to Play</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-2">
        <h4>Sort By...</h4>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="SortByTitle" class="btn btn-primary">
            Title
        </a>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="SortByPlatform" class="btn btn-primary">
            Platform
        </a>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="SortByDate" class="btn btn-primary">
            Date Added
        </a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-2">
        <h4>Status</h4>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="AllGames" class="btn btn-primary">
            All 
        </a>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="CompletedGames" class="btn btn-primary">
            Completed
        </a>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="NotStartedGames" class="btn btn-primary">
            Not Started
        </a>
    </div>
</div>

@* Check if there are any games to display *@
@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <h4>No games yet!</h4>
        <p>Click "Add New Game" to start building your backlog.</p>
    </div>
}
else
{
    @* Create a table to show all the games *@
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Platform</th>
                    <th>Genre</th>
                    <th>Status</th>
                    <th>Rating</th>
                    <th>Date Added</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @* Loop through each game in the Model and create a row *@
                @foreach (var game in Model)
                {
                    <tr>
                        <td>
                            <strong>@game.Title</strong>
                        </td>
                        <td>@game.Platform</td>
                        <td>
                            <span class="badge bg-secondary">@game.Genre</span>
                        </td>
                        <td>
                            @if (game.IsCompleted)
                            {
                                <span class="badge bg-info">? Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-dark">? Not Started</span>
                            }
                        </td>
                        @if (game.Rating == "1")
                        {
                            <td>
                                <i class="bi bi-star-fill"></i>
                                @for (int i = 0; i < 4; i++)
                                {
                                <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "2")
                        {
                            <td>
                                @for (int i = 0; i < 2; i++)
                                {
                                <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 3; i++)
                                {
                                <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "3")
                        {
                            <td>
                                @for (int i = 0; i < 3; i++)
                                {
                                <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 2; i++)
                                {
                                <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "4")
                        {
                            <td>
                                @for (int i = 0; i < 4; i++)
                                {
                                <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 1; i++)
                                {
                                <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "5")
                        {
                            <td>
                                @for (int i = 0; i < 5; i++)
                                {
                                <i class="bi bi-star-fill"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "0")
                        {
                            <td>
                                @for (int i = 0; i < 5; i++)
                                {
                                <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        <td>@game.DateAdded.ToString("MMM dd, yyyy")</td>
                        <td>
                            @* Action buttons for each game *@
                            <a asp-action="Edit" asp-route-id="@game.Id" 
                               class="btn btn-sm btn-outline-primary" 
                               title="Edit this game">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@game.Id" 
                               class="btn btn-sm btn-outline-danger" 
                               title="Delete this game">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
