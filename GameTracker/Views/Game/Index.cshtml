@* @*
    This is the INDEX VIEW - it displays the list of all games
    VIEWS are HTML templates that show information to the user
    The @ symbol lets us write C# code inside HTML
*@
@model List<GameTracker.Models.Game>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
@*
    @model tells us what type of data this view expects
    In this case, we expect a List of Game objects from the controller
*@

@using System.Linq

@{
    ViewData["Title"] = "My Game Backlog";
    var grouped = Model?.GroupBy(g => g.Platform).ToDictionary(g => g.Key, g => g.Count());
    var DropGenre = Model?.GroupBy(g => g.Genre).ToDictionary(g => g.Key, g => g.Count());
}
<div class="row mb-3">
    <div class="col-md-8">
        <h1>My Game Backlog</h1>
        <p class="text-muted">Track all the games you want to play!</p>
    </div>
    <div class="col-md-4 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="Create" class="btn btn-primary">
            Add New Game
        </a>
    </div>
    <div class="col-md-12 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="ExportToText" class="btn btn-primary">
            Export to Text File
        </a>
    </div>
</div>


