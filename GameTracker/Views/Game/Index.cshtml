    Posted by user7217806
    Retrieved 2026-06-16, License - CC BY-SA 4.0*@ 

<form asp-controller="Game" asp-action="Index" method="get" class="d-flex mb-3">
    @Html.TextBox("searchString", null, new { @class = "form-control me-2", placeholder = "Search titles..." })
    <button type="submit" class="btn btn-secondary">Search</button>
</form>


@* Show statistics about the



*@
<div class="row mb-3">
    <div class="col-md-2">
        <div class="card">
            <div class="card-body text-center">
                <h3>@Model.Count</h3>
                <p class="text-muted mb-0">Total Games</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card">
            <div class="card-body text-center">
                <h3>@Model.Count(g => g.IsCompleted)</h3>
                <p class="text-muted mb-0">Completed</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card">
            <div class="card-body text-center">
                <h3>@Model.Count(g => !g.IsCompleted)</h3>
                <p class="text-muted mb-0">Still to Play</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card">
            <div class="card-body text-center">
                <h3>@(Model?.Select(g => g.HoursToComplete).Sum() ?? 0)</h3>
                <p class="text-muted mb-0">Total Hours</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card">
            <div class="card-body text-center">
                <h3>@Math.Round((Model?.Select(g => g.HoursToComplete).Average() ?? 0))</h3>
                <p class="text-muted mb-0">Avg Hours</p>
            </div>
        </div>
    </div>
    @foreach (var g in grouped)
    {
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">

                    <h3>
                        @g.Value
                    </h3>


                    <p class="text-muted mb-0">@g.Key</p>
                </div>
            </div>
        </div>
    }
</div>


<div class="row mb-3">
    <div class="col-md-2">
        <h4>Sort By...</h4>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="SortByTitle" class="btn btn-primary">
            Title
        </a>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="SortByPlatform" class="btn btn-primary">
            Platform
        </a>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="SortByDate" class="btn btn-primary">
            Date Added
        </a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-2">
        <h4>Status</h4>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="AllGames" class="btn btn-primary">
            All
        </a>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="CompletedGames" class="btn btn-primary">
            Completed
        </a>
    </div>
    <div class="col-md-1 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="NotStartedGames" class="btn btn-primary">
            Not Started
        </a>
    </div>
</div>


<form asp-action="Index" id="inputState" class="form-control" method="get">
    <div>
        <select class="form-select" name="GenreFilter">
            <option selected>Please Choose...</option>
            @foreach (var g in DropGenre)
            {
                <option value="@g.Key">@g.Key</option>
            }

        </select>
    </div>
    <div class="col-md-2">
        @* This creates a button that links to the Create page *@
        <button type="submit" class="btn btn-primary">Apply</button>
    </div>
</form>
@* Check if there are any games to display *@
@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <h4>No games yet!</h4>
        <p>Click "Add New Game" to start building your backlog.</p>
    </div>
}
else
{
    @* Create a table to show all the games *@
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Platform</th>
                    <th>Hours to Complete</th>
                    <th>Genre</th>
                    <th>Status</th>
                    <th>Rating</th>
                    <th>Date Added</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @* Loop through each game in the Model and create a row *@
                @foreach (var game in Model)
                {
                    <tr>
                        <td>
                            <strong>@game.Title</strong>
                        </td>
                        @if (game.Platform == "PC")
                        {
                            <td>
                                <i class="bi bi-pc-display-horizontal"></i>
                            </td>
                        }
                        else if (game.Platform == "PlayStation 5")
                        {
                            <td>
                                <i class="bi bi-playstation"></i>
                            </td>
                        }
                        else if (game.Platform == "Xbox")
                        {
                            <td>
                                <i class="bi bi-xbox"></i>
                            </td>
                        }
                        else if (game.Platform == "Nintendo Switch")
                        {
                            <td>
                                <i class="bi bi-nintendo-switch"></i>
                            </td>

                        }
                        else if (game.Platform == "Multi-platform")
                        {
                            <td>

                                <i class="bi bi-pc-display-horizontal"></i>
                                <i class="bi bi-playstation"></i>
                                <i class="bi bi-xbox"></i>
                                <i class="bi bi-nintendo-switch"></i>
                            </td>
                        }
                        <td>
                            <span class="badge bg-secondary">@game.HoursToComplete</span>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@game.Genre</span>
                        </td>
                        <td>
                            @if (game.IsCompleted)
                            {
                                <span class="badge bg-info">? Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-dark">? Not Started</span>
                            }
                        </td>
                        @if (game.Rating == "1")
                        {
                            <td>
                                <i class="bi bi-star-fill"></i>
                                @for (int i = 0; i < 4; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "2")
                        {
                            <td>
                                @for (int i = 0; i < 2; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 3; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "3")
                        {
                            <td>
                                @for (int i = 0; i < 3; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 2; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "4")
                        {
                            <td>
                                @for (int i = 0; i < 4; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 1; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "5")
                        {
                            <td>
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                            </td>
                        }
                        else if (game.Rating == "0")
                        {
                            <td>
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        <td>@game.DateAdded.ToString("MMM dd, yyyy")</td>
                        <td>
                            @* Action buttons for each game *@
                            <a asp-action="Edit" asp-route-id="@game.Id"
                               class="btn btn-sm btn-outline-primary"
                               title="Edit this game">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@game.Id"
                               class="btn btn-sm btn-outline-danger"
                               title="Delete this game">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


<div class="row mb-5">

    <div class="col-md-3 text-end">
        @* This creates a button that links to the Create page *@
        <a asp-action="ExportToText" class="btn btn-primary">
            Export to Text File
        </a>
    </div>
</div>