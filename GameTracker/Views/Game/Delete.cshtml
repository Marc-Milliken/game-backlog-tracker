@* 
    This is the DELETE VIEW - it shows a confirmation page before deleting
    This is important so users don't accidentally delete games!
*@

@model GameTracker.Models.Game

@{
    ViewData["Title"] = "Delete Game";
}

<h1> Delete Game</h1>
<div class="alert alert-warning">
    <h4> Are you sure you want to delete this game?</h4>
    <p>This action cannot be undone!</p>
</div>

<hr />

<div class="row">
    <div class="col-md-8">
        @* Show the game details so the user knows what they're deleting *@
        <div class="card">
            <div class="card-header">
                <h4>@Model.Title</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Platform:</dt>
                    <dd class="col-sm-9">@Model.Platform</dd>

                    <dt class="col-sm-3">Genre:</dt>
                    <dd class="col-sm-9">@Model.Genre</dd>

                    <dt class="col-sm-3">Rating:</dt>
                    <dd class="col-sm-9">@Model.Rating</dd>

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-success">Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Not Started</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Date Added:</dt>
                    <dd class="col-sm-9">@Model.DateAdded.ToString("MMMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>

        @* 
            Form to confirm deletion
            Notice it calls the DeleteConfirmed action, not Delete
            This is to prevent accidental deletions from URL manipulation
        *@
        <form asp-action="DeleteConfirmed" method="post" class="mt-3">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">
                 Yes, Delete This Game
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                No, Take Me Back
            </a>
        </form>
    </div>

    <div class="col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h5 class="card-title"> What happens?</h5>
                <p class="small">
                    If you click "Yes, Delete This Game", this game will be 
                    permanently removed from your backlog. You can always 
                    add it again later if you change your mind!
                </p>
            </div>
        </div>
    </div>
</div>
