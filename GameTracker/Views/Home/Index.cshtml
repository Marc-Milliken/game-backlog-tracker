@{
    ViewData["Title"] = "Home Page";
}
@model List<GameTracker.Models.Game>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

@using System.Linq
<div class="text-center">
    <h1 class="display-4">🎮 Game Backlog Tracker</h1>
    <p class="lead">Keep track of all the games you want to play!</p>
    <hr />
    <p>
        <a asp-controller="Game" asp-action="Index" class="btn btn-primary btn-lg">
            View My Game Backlog →
        </a>
    </p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h3>📝 Track</h3>
                <p>Add all the games you want to play to your backlog</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h3>✅ Organize</h3>
                <p>Keep track of which games you've completed</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h3>🎯 Plan</h3>
                <p>See your gaming backlog and plan what to play next</p>
            </div>
        </div>
    </div>
</div>

<div class="text-center">
    <h1 class="display-4">Recently Added</h1>
    <hr />

</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <h4>No games yet!</h4>
        <p>Click "Add New Game" to start building your backlog.</p>
    </div>
}
else
{
    @* Create a table to show all the games *@
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Platform</th>
                    <th>Hours to Complete</th>
                    <th>Genre</th>
                    <th>Status</th>
                    <th>Rating</th>
                    <th>Date Added</th>
                </tr>
            </thead>
            <tbody>
                @* Loop through each game in the Model and create a row *@
                @foreach (var RecentlyAdded in Model)
                {
                    <tr>
                        <td>
                            <strong>@RecentlyAdded.Title</strong>
                        </td>
                        @if (RecentlyAdded.Platform == "PC")
                        {
                            <td>
                                <i class="bi bi-pc-display-horizontal"></i>
                            </td>
                        }
                        else if (RecentlyAdded.Platform == "PlayStation 5")
                        {
                            <td>
                                <i class="bi bi-playstation"></i>
                            </td>
                        }
                        else if (RecentlyAdded.Platform == "Xbox")
                        {
                            <td>
                                <i class="bi bi-xbox"></i>
                            </td>
                        }
                        else if (RecentlyAdded.Platform == "Nintendo Switch")
                        {
                            <td>
                                <i class="bi bi-nintendo-switch"></i>
                            </td>

                        }
                        else if (RecentlyAdded.Platform == "Multi-platform")
                        {
                            <td>

                                <i class="bi bi-pc-display-horizontal"></i>
                                <i class="bi bi-playstation"></i>
                                <i class="bi bi-xbox"></i>
                                <i class="bi bi-nintendo-switch"></i>
                            </td>
                        }
                        <td>
                            <span class="badge bg-secondary">@RecentlyAdded.HoursToComplete</span>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@RecentlyAdded.Genre</span>
                        </td>
                        <td>
                            @if (RecentlyAdded.IsCompleted)
                            {
                                <span class="badge bg-info">? Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-dark">? Not Started</span>
                            }
                        </td>
                        @if (RecentlyAdded.Rating == "1")
                        {
                            <td>
                                <i class="bi bi-star-fill"></i>
                                @for (int i = 0; i < 4; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (RecentlyAdded.Rating == "2")
                        {
                            <td>
                                @for (int i = 0; i < 2; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 3; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (RecentlyAdded.Rating == "3")
                        {
                            <td>
                                @for (int i = 0; i < 3; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 2; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (RecentlyAdded.Rating == "4")
                        {
                            <td>
                                @for (int i = 0; i < 4; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = 0; i < 1; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        else if (RecentlyAdded.Rating == "5")
                        {
                            <td>
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                            </td>
                        }
                        else if (RecentlyAdded.Rating == "0")
                        {
                            <td>
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </td>
                        }
                        <td>@RecentlyAdded.DateAdded.ToString("MMM dd, yyyy")</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}